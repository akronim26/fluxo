# Paths only; never commit real keypairs. Copy to .env and fill in.
RPC_URL=https://api.devnet.solana.com
# Pays for and administers the pool (same wallet as `anchor deploy`).
ADMIN_KEYPAIR=~/.config/solana/id.json
# tUSDC mint authority used by the gateway faucet. Generated here if the file does not exist.
FAUCET_KEYPAIR=~/.config/fluxo/faucet-authority.json
# CRE simulator mock forwarder, from cre-templates solana-read-write config.simulation.json.
FORWARDER_PROGRAM=7kuEAA3mSC1Tz8gQjnvH7bKFda9xSPRRin9SZbH49cNK
