# Leave empty for same-origin deployment or Vite's local gateway proxy.
VITE_GATEWAY_URL=
# Local development only; never expose the private mailbox on 8787.
GATEWAY_PROXY_TARGET=http://127.0.0.1:8788
# Optional public devnet RPC endpoint. Never put private API credentials here.
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
