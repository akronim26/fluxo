WORKFLOWS_DIR=../workflows
DEVNET_CONFIG_PATH=../deploy/devnet.json
PORT=8788
MAILBOX_PORT=8787
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# true only behind a Cloudflare tunnel
TRUST_CLOUDFLARE=false

# Devnet keypair paths
FAUCET_KEYPAIR_PATH=
FAUCET_MINT_AUTHORITY_PATH=
RELAYER_KEYPAIR=

# Optional, default to the binaries on PATH
NODE_BIN=
CRE_BIN=
SPL_TOKEN_BIN=
SOLANA_BIN=
