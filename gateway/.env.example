# Paths only. Fill these locally; never paste secret values into chat.
# Use the configured workflow directory so its CRE CLI can load matching secrets.
# Put SOLANA_DEVNET_RPC_URL in that directory's .env locally; do not paste it here.
# Both staging and faucet CLIs load it there; faucet requires it before funding.
# Build scripts/build-wasm.sh there once after workflow changes, before starting.
WORKFLOWS_DIR=../workflows
DEVNET_CONFIG_PATH=../deploy/devnet.json
PORT=8788
MAILBOX_PORT=8787
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Enable only behind a Cloudflare tunnel that overwrites CF-Connecting-IP.
TRUST_CLOUDFLARE=false
# Funded devnet signer; must control lane B's mint unless authority differs below.
FAUCET_KEYPAIR_PATH=
FAUCET_MINT_AUTHORITY_PATH=
# Funded devnet signer for D6 stage_spend. Prefer an absolute path.
# Pays approximately 0.002 SOL pending-account rent; finalize refunds it.
RELAYER_KEYPAIR=
# Legacy frontend setup alias RELAYER_KEYPAIR_PATH is also accepted.
# Optional executable paths; use Node 23 for staging's --env-file-if-exists.
# Defaults are node, cre, spl-token and solana on PATH.
NODE_BIN=
CRE_BIN=
SPL_TOKEN_BIN=
SOLANA_BIN=
